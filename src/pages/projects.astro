  },
  {
    name: "Messenger",
    what: "A desktop chat app.",
    role: "Student project.",
    stack: ["Java", "JavaFX", "Sockets"],
    links: [{ label: "Code", href: "https://github.com/iftekharzeeon/Messenger-javafx" }],
  },
  {
    name: "Car Warehouse Database System",
    what: "A client and server app for a car showroom, over Java networking.",
