---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE, author } from "../../lib/schema";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: notes } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const others = all
  .filter((n) => n.id !== entry.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={entry.data.title} description={entry.data.summary} type="article" jsonLd={[{ "@type": "BlogPosting", headline: entry.data.title, description: entry.data.summary, author, datePublished: entry.data.date.toISOString().slice(0, 10), url: `${SITE}/notes/${entry.id}/`, image: `${SITE}/og.png` }]}>
  <a class="back" href="/notes/">All notes</a>
  <header class="article-head">
    <h1>{entry.data.title}</h1>
    <p class="work-meta"><time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmt(entry.data.date)}</time></p>
    <p class="lede">{entry.data.summary}</p>
  </header>
  <div class="article-grid">
    <article class="article-body">
      <Content />
    </article>
    <aside class="margin-notes" aria-label="Related pages">
      {entry.data.related && (
        <>
          <h2>The project behind it</h2>
          <p><a href={entry.data.related.href}>{entry.data.related.title}</a></p>
        </>
      )}
      {others.length > 0 && (
        <>
          <h2>More notes</h2>
          <ul>
            {others.map((n) => (
              <li><a href={`/notes/${n.id}/`}>{n.data.title}</a></li>
            ))}
          </ul>
        </>
      )}
    </aside>
  </div>
</Base>
