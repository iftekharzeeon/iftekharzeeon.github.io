---
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource/ibm-plex-sans-condensed/latin-400.css";
import "@fontsource/ibm-plex-sans-condensed/latin-500.css";
import "@fontsource/ibm-plex-sans-condensed/latin-600.css";
import "../styles/global.css";
import { SITE, person } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article" | "profile";
  jsonLd?: Record<string, unknown>[];
}

const site = "Iftekhar E Mahbub Zeeon";
const { title, description = "Full-stack software engineer in Dhaka, Bangladesh, at Retune AI and Pridesys IT Ltd.", type = "website", jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${site}` : `${site}, full-stack software engineer`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${SITE}/#website`, url: `${SITE}/`, name: site, inLanguage: "en", publisher: { "@id": `${SITE}/#person` } },
    person,
    ...jsonLd,
  ],
};
const nav = [
  { href: "/#work", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#research", label: "Research" },
  { href: "/#notes", label: "Notes" },
  { href: "/education/", label: "Education" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="author" content="Iftekhar E Mahbub Zeeon" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Iftekhar E Mahbub Zeeon, full-stack software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <meta name="theme-color" content="#f2f4ef" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="frame">
      <header class="site-head">
        <a class="home" href="/">Zeeon</a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href.replace(/\/$/, "") ? "page" : undefined}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="Switch colour theme">Theme</button>
        </nav>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="site-foot">
        <span>Iftekhar E Mahbub Zeeon, Dhaka</span>
        <span>
          <a href="mailto:mahbubzeeon@gmail.com">mahbubzeeon@gmail.com</a></span>
        <span><a href="/now/">What I am doing now</a>
        </span>
      </footer>
    </div>
    <script is:inline>
      (function () {
        const btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        const root = document.documentElement;
        const current = () => (root.dataset.theme === "dark" ? "dark" : "light");
        const label = () => {
          const next = current() === "dark" ? "light" : "dark";
          btn.textContent = next === "dark" ? "Dark" : "Light";
          btn.setAttribute("aria-label", "Use the " + next + " theme");
        };
        label();
        btn.addEventListener("click", function () {
          const next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
