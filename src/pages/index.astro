---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const jobs = [
  {
    org: "Retune AI Inc",
    role: "Software engineer, remote (USA)",
    dates: "Sep 2023 – present",
    points: [
      "Building re:frame, a platform where people and AI agents write apps that run as soon as the code is saved.",
      "Built the hybrid BM25 and vector search behind retune.so. Retrieval improved by 40%, and the product made USD 700K+ in its first 2 months on AppSumo.",
      "Built awaken.is, an AI coaching product with 78% retention across 500+ users, and the AlterCall Virtual Coach.",
      "Run production and security for TELE's multilingual WordPress site on GCP. Built a Microsoft Graph tool that turned 2,495 emails into 120 tracked actions.",
    ],
  },
  {
    org: "Pridesys IT Ltd",
    role: "Software engineer, Dhaka",
    dates: "Nov 2023 – present",
    points: [
      "Led a team of 11 to ship a SaaS accounting product on Azure for small businesses in Bangladesh. Built the Spring Boot and Kafka services, the multi-tenant database (200 TPS) and the React frontend.",
      "Architected Farmers Card, the national farmer registry for 2.5M+ farmers, which connects 4 mobile apps and a web back office. Built most of its identity and platform services.",
      "Lead the rebuild of a 7,143-screen Oracle ERP in React, Spring Boot and PostgreSQL.",
    ],
  },
  {
    org: "VIPB Asset Management",
    role: "Software engineer, contract, Dhaka",
    dates: "May 2026 – Nov 2026",
    points: [
      "Replaced the company's manual Excel work with one scalable system, and moved all 6 mutual funds onto it.",
      "Built a customer portal and an admin portal on one backend, and automated the whole flow from a customer's purchase to the fund's accounting books.",
      "Only developer, frontend and backend: Next.js for the website and both portals, Fastify for the API, PostgreSQL for the data.",
    ],
  },
  {
    org: "BYDO Academy",
    role: "Junior software engineer, remote",
    dates: "Sep 2020 – Sep 2021",
    points: ["Built the SSLCommerz payment gateway, which handled 300+ requests a day, and the site's REST API."],
  },
];

const projects = [
  {
    name: "re:frame",
    what: "A platform where people and AI agents write apps that run as soon as the code is saved.",
    links: [{ label: "Website", href: "https://reframe.so" }],
  },
  {
    name: "retune.so",
    what: "Lets businesses build AI chatbots on their own documents. I built its hybrid search.",
    links: [{ label: "Live site", href: "https://retune.so" }],
  },
  {
    name: "Grow Your Career",
    what: "A career platform for students in Bangladesh, with AI résumé scoring and mentorship.",
    links: [{ label: "Live site", href: "https://gycplatform.com" }],
  },
  {
    name: "Porjay",
    what: "Candidates report the stages of their job applications, so others can see how each company hires.",
    links: [{ label: "Live site", href: "https://porjay.com" }],
  },
];

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Base>
  <section class="hero" aria-labelledby="who">
    <div class="bio">
      <h1 id="who">Iftekhar E Mahbub Zeeon</h1>
      <p class="where">Full-stack software engineer at Retune AI and Pridesys IT Ltd</p>
      <p>
        I am a full-stack software engineer based in Dhaka, Bangladesh. I build web products from end to end:
        the interface in React and Next.js, the backend in Spring Boot and Node.js, the database in PostgreSQL,
        and the cloud and Kubernetes setup that runs them.
      </p>
      <p>
        At <a href="https://retune.so">Retune AI</a>, I am building <a href="https://reframe.so">re:frame</a>, a
        platform where apps run as soon as the code is saved. Before that I built AI products such as retune.so and
        <a href="https://awaken.is">awaken.is</a>. At Pridesys IT Ltd, I architected
        <a href="https://krishokcard.gov.bd">Farmers Card</a>, Bangladesh's national farmer registry for 2.5M+
        farmers, and I lead the rebuild of a large ERP system. From May to November 2026, I also replaced
        <a href="https://vipbamc.com">VIPB Asset Management</a>'s manual spreadsheet work with a customer portal and an
        admin portal that automate the whole flow from customer to accounting, as its only developer.
      </p>
      <p>
        I received my B.Sc. in Computer Science and Engineering from
        <a href="https://www.buet.ac.bd">BUET</a> in 2024. My undergraduate thesis, supervised by Dr. Muhammad
        Abdullah Adnan, introduced <a href="/research/">BTVSL</a>, a Bangla Sign Language dataset, and was published at
        IEEE FG 2024.
      </p>
      <ul class="contact-links">
        <li><a href="mailto:mahbubzeeon@gmail.com">Email</a></li>
        <li><a href="https://github.com/iftekharzeeon">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/iftekhar-zeeon">LinkedIn</a></li>
        <li><a href="https://doi.org/10.1109/FG59268.2024.10581873">Paper</a></li>
      </ul>
    </div>
    <img class="portrait" src="/zeeon-portrait.jpg" width="600" height="800" alt="Iftekhar E Mahbub Zeeon" fetchpriority="high" />
  </section>

  <section class="section" id="work" aria-labelledby="work-h">
    <h2 id="work-h">Selected work</h2>
    <ul class="work-list">
      {work.map((w) => (
        <li class="work-item">
          <h3><a href={`/work/${w.id}/`}>{w.data.title}</a></h3>
          <p class="work-meta">{w.data.org}. {w.data.role}.</p>
          <p class="prose">{w.data.summary}</p>
          <p class="pair">
            <span class="label">{w.data.proof.label}: </span>
            {w.data.proof.kind !== "single" && (
              <>
                <span class:list={[w.data.proof.kind === "improve" && "before"]}>{w.data.proof.before}</span>
                <span class="label"> {w.data.proof.kind === "improve" ? "to" : "against"} </span>
              </>
            )}
            <span class="after">{w.data.proof.after}</span>
          </p>
          <ul class="stack" aria-label="Technology">
            {w.data.stack.map((s) => <li>{s}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="experience" aria-labelledby="exp-h">
    <h2 id="exp-h">Experience</h2>
    <ol class="jobs">
      {jobs.map((j) => (
        <li class="job">
          <div class="job-dates">{j.dates}</div>
          <div>
            <h3>{j.org}</h3>
            <p class="job-role">{j.role}</p>
            <ul>
              {j.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="projects" aria-labelledby="proj-h">
    <h2 id="proj-h">Projects</h2>
    <div>
      <ul class="project-list">
        {projects.map((p) => (
          <li class="project">
            <h3>{p.name}</h3>
            <p>{p.what}</p>
            <ul class="project-links">
              {p.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
      <p style="margin-top: 1.5rem;"><a href="/projects/">All projects, with links</a></p>
    </div>
  </section>

  <section class="section" id="research" aria-labelledby="res-h">
    <h2 id="res-h">Research</h2>
    <div class="prose">
      <p>
        <a href="/research/">BTVSL: A Novel Sentence-Level Annotated Dataset for Bangla Sign Language Translation</a>.
        IEEE FG 2024.
      </p>
      <p class="quiet">
        A dataset of 60 hours of signed Bangla news, matched sentence by sentence with text. My undergraduate thesis,
        supervised by Dr. Muhammad Abdullah Adnan.
      </p>
      <p><a href="/research/">About the paper</a></p>
    </div>
  </section>

  <section class="section" id="notes" aria-labelledby="notes-h">
    <h2 id="notes-h">Notes</h2>
    <div>
      <ul class="plain note-list">
        {notes.map((n) => (
          <li>
            <a href={`/notes/${n.id}/`}>{n.data.title}</a>
            <p><span class="figures">{fmt(n.data.date)}</span>. {n.data.summary}</p>
          </li>
        ))}
      </ul>
      <p><a href="/notes/">All notes</a></p>
    </div>
  </section>

  <section class="section" id="education" aria-labelledby="edu-h">
    <h2 id="edu-h">Education</h2>
    <div class="prose">
      <ul class="plain home-schools">
        <li><strong>Bangladesh University of Engineering and Technology (BUET)</strong>. B.Sc. in Computer Science and Engineering, 2019–2024.</li>
        <li><strong>Notre Dame College, Dhaka</strong>. HSC.</li>
        <li><strong>Government Laboratory High School, Dhaka</strong>. SSC.</li>
      </ul>
      <p class="quiet">Awards: BASIS National ICT Award 2020, winner. BUET CSE Fest Hackathon 2022, first runner-up. Therap Java Fest 2022, finalist.</p>
      <p><a href="/education/">Education and awards</a></p>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-h">
    <h2 id="contact-h">Contact</h2>
    <div class="prose">
      <p>
        Email is the best way to reach me: <a href="mailto:mahbubzeeon@gmail.com">mahbubzeeon@gmail.com</a>.
      </p>
      <ul class="contact-links">
        <li><a href="https://github.com/iftekharzeeon">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/iftekhar-zeeon">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .skip-label {
    position: absolute;
    left: -999px;
  }
  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 3.5rem;
    }
    .hero .portrait {
      margin-top: 0.5rem;
    }
  }
</style>
