const groups = [
  { title: "Products", intro: "Products I built or work on.", items: work },
  { title: "Student and personal projects", intro: "From my years at BUET.", items: student },
];
---

<Base title="Projects" description="Products and projects by Iftekhar E Mahbub Zeeon, with links to live sites and code.">
  <header class="article-head">
    <h1>Projects</h1>
    <p class="lede">Products I have built or work on, and projects from my student years. Each one links to the live site or the code where it is public.</p>
  </header>

  {groups.map((g) => (
    <section class="section" aria-label={g.title}>
      <h2>{g.title}</h2>
      <ul class="project-list">
        {g.items.map((p) => (
          <li class="project">
            <h3>{p.name}</h3>
            <p>{p.what}</p>
            <p class="quiet">{p.role}</p>
            <ul class="stack" aria-label="Technology">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
            {p.links.length > 0 && (
              <ul class="project-links">
                {p.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="quiet" style="margin-top: 3rem;">
    All my BUET coursework is on <a href="https://github.com/iftekharzeeon/undergraduate_academics">GitHub</a>.
  </p>
</Base>
